---
import Layout from '../layouts/Layout.astro';
import { services } from '../data/site.js';
---
<Layout title="ভূমিসেবা.বাংলা — ভূমির জটিল বিষয়, সহজ ভাষায়">

  <section class="bg-mist">
    <div class="mx-auto flex max-w-[1160px] flex-wrap items-center justify-between gap-6 px-4 py-8 md:gap-8 md:px-5 md:py-14">
      <div class="flex-[1_1_420px]">
        <h1 class="mb-4 text-[28px] font-bold leading-[1.35] text-deep md:text-[40px]">ভূমির জটিল বিষয়, সহজ ভাষায়</h1>
        <p class="mb-6 max-w-[560px] text-lg leading-[1.7]">আনা-গন্ডা থেকে শতাংশ, ওয়ারিশ অংশ, নামজারির ধাপ ও ফি — ঘরে বসেই জানুন, হিসাব করুন।</p>
        <div class="flex flex-wrap gap-3">
          <a href="#" class="rounded-[10px] bg-flag px-6 py-3.5 text-[17px] font-semibold text-white">আনা-গন্ডা কনভার্ট করুন</a>
          <a href="/process" class="rounded-[10px] border-2 border-flag bg-white px-6 py-3.5 text-[17px] font-semibold text-deep">সেবা পদ্ধতি দেখুন</a>
        </div>
      </div>
      <div class="flex-[0_1_340px] rounded-2xl border border-[#CBE3D3] bg-white p-6">
        <div class="text-[15px] text-muted">একটি দ্রুত হিসাব</div>
        <div class="my-2 text-[26px] font-bold text-deep">১ কাঠা = ১.৬৫ শতাংশ</div>
        <div class="text-[15px] leading-[1.6] text-muted">সব হিসাব আপনার ব্রাউজারেই হয়। কোনো তথ্য কোথাও জমা হয় না।</div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-[1160px] px-4 pb-4 pt-10 md:px-5">
    <h2 class="mb-2 text-[28px] font-bold">সেবা ও অ্যাপ</h2>
    <p class="mb-7 text-base text-muted">একটি কার্ডে ছুঁয়ে সংশ্লিষ্ট অ্যাপ বা তথ্যের পাতায় যান।</p>
    <div class="grid grid-cols-2 gap-3 md:grid-cols-[repeat(auto-fit,minmax(200px,1fr))] md:gap-5">
      {services.map((s) => (
        <a
          href={s.href}
          class={`flex min-h-[150px] flex-col overflow-hidden rounded-[14px] border transition-transform hover:-translate-y-[3px] ${s.dark ? 'border-deep bg-deep text-white' : 'border-line bg-white'}`}
        >
          <div class="h-2" style={`background:${s.color}`}></div>
          <div class="mt-[22px] flex h-14 items-center justify-center" style={`color:${s.color}`}>
            <svg width="48" height="48" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={s.icon}></svg>
          </div>
          <div class="px-3 pb-[22px] pt-2.5 text-center text-base font-bold leading-[1.45] md:text-lg">{s.name}</div>
        </a>
      ))}
    </div>
  </section>

  <section class="mx-auto max-w-[1160px] px-4 pb-12 pt-8 md:px-5">
    <div class="rounded-[14px] border border-line bg-white p-[22px] text-base leading-[1.7]">
      <strong>জ্ঞাতব্য:</strong> এই সাইটের তথ্য সাধারণ তথ্য, আইনি পরামর্শ নয়। প্রতিটি পাতায় আইনের সূত্র ও সর্বশেষ হালনাগাদের তারিখ দেওয়া থাকবে।
    </div>
  </section>

</Layout>